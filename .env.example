# Trainer Chandan — environment template
#
# Copy to .env.local for local dev (`cp .env.example .env.local`), or feed these to the
# container in production (docker `env_file:` / `-e`).
#
# Every variable below is SERVER-SIDE ONLY — there are no NEXT_PUBLIC_* vars in this
# codebase, so nothing here is baked into the client bundle at build time. That means a
# container restart picks up changes; you do NOT need to rebuild the image.
#
# Everything is optional. Each feature is behind a "configured" flag and degrades
# gracefully when its vars are absent: the widget hides itself, the endpoint returns
# { configured: false }, or the form returns 503. Nothing crashes, and routing is never
# affected. Partial groups count as unconfigured — set all vars in a group or none.


# ─── Database (Neon serverless Postgres) ─────────────────────────────────────
# Powers: Journal posts authored in the Control Room, the visitor counter, and the
# Hall of Fame leaderboard. Without it the Journal shows only file-based MDX entries,
# /api/visits returns 0, and the leaderboard is empty and unsubmittable.
#
# After setting this, create the tables: node scripts/db-init.mjs
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require


# ─── Admin Control Room (/control-room) ──────────────────────────────────────
# Password + TOTP 2FA, with an HMAC-signed session cookie (2h TTL).
# ALL THREE are required — if any is missing, isAdminConfigured() is false and login
# can never succeed (the page still renders; it just won't let you in).
#
# Generate TOTP_SECRET and SESSION_SECRET with: node scripts/gen-totp.cjs
# That script also prints an otpauth:// URI to add to your authenticator app.

# The login password (compared in constant time).
ADMIN_PASSWORD=

# Base32 TOTP secret shared with your authenticator app (RFC 6238, SHA-1, 6 digits, 30s).
TOTP_SECRET=

# Random 32+ character string used to sign the session cookie.
# Rotating this invalidates all existing admin sessions.
SESSION_SECRET=


# ─── Contact form ("Send Transmission") ──────────────────────────────────────
# SMTP_HOST + SMTP_USER + SMTP_PASS are required together; without all three the
# endpoint returns 503 "Email is not configured yet."
# Gmail: use an App Password, not your account password.

SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=

# Optional. Defaults to 465. 465 = implicit TLS, 587 = STARTTLS.
SMTP_PORT=465

# Optional. Overrides the destination inbox.
# Defaults to chandanp24107@gmail.com when unset.
CONTACT_TO=


# ─── Spotify "Now Playing" widget ────────────────────────────────────────────
# ALL THREE required, or /api/spotify/now-playing returns { configured: false } and the
# widget hides itself. The refresh token stays server-side and is exchanged for a
# short-lived access token per request.
#
# Create an app at https://developer.spotify.com/dashboard and add the redirect URI
# http://127.0.0.1:8888/callback to it. Then fill in the client id/secret below and run:
#
#   node scripts/gen-spotify-token.mjs
#
# That walks the authorization-code flow once (user-read-currently-playing and
# user-read-recently-played scopes) and prints the refresh token to paste in here.
#
# Note: a refresh token only works with the client id/secret it was minted under, and
# dies if you revoke the app at https://www.spotify.com/account/apps. Re-run the script
# after either. A dead token looks identical to "not configured" from the browser —
# the widget hides itself — but the server logs "[spotify] token refresh failed".

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=


# ─── Not configurable ────────────────────────────────────────────────────────
# NODE_ENV is set by Next.js (development for `next dev`, production for `next start`).
# Do not set it manually — it gates draft Journal entries and the Secure cookie flag.
